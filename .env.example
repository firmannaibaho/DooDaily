# ═══════════════════════════════════════════════════════════════
# Doodaily Art — Template Environment
# Salin file ini menjadi .env.local lalu isi nilainya.
#   cp .env.example .env.local
# JANGAN commit .env.local — sudah masuk .gitignore.
# ═══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. JANGAN beri prefix NEXT_PUBLIC_ agar tidak bocor ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── NextAuth / Auth.js ────────────────────────────────────────
# Generate nilai acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXTAUTH_SECRET dan AUTH_SECRET HARUS bernilai sama.
NEXTAUTH_SECRET=
AUTH_SECRET=

