# ═══════════════════════════════════════════════════════════════
# Doodaily Art — Template Environment
# Salin file ini menjadi .env.local lalu isi nilainya.
#   cp .env.example .env.local
# JANGAN commit .env.local — sudah masuk .gitignore.
# ═══════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────
# Dashboard Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. JANGAN beri prefix NEXT_PUBLIC_ agar tidak bocor ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# Nama bucket Supabase Storage untuk unggahan (bukti bayar, referensi, testimoni).
# Buat bucket PUBLIC bernama "uploads" (atau ganti di sini).
# Lihat docs/setup-storage-bucket.sql
SUPABASE_UPLOAD_BUCKET=uploads
# Dipakai komponen client untuk membentuk URL gambar unggahan.
NEXT_PUBLIC_UPLOAD_BUCKET=uploads

# ── NextAuth / Auth.js ────────────────────────────────────────
# Generate nilai acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# NEXTAUTH_SECRET dan AUTH_SECRET HARUS bernilai sama.
NEXTAUTH_SECRET=
AUTH_SECRET=

# ── Chatbot balasan otomatis ───────────────────────────────────
# 1 = aktif, selain itu bot diam total.
CHATBOT_ENABLED=0
# Endpoint OpenAI-compatible (mis. Google Gemini, Groq, OpenRouter, OpenAI).
CHAT_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Server-only. JANGAN beri prefix NEXT_PUBLIC_.
CHAT_API_KEY=
CHAT_MODEL=gemini-2.5-flash
CHATBOT_TIMEOUT_MS=20000
CHATBOT_MAX_REPLIES=6
CHATBOT_MAX_CONTEXT_MESSAGES=10

